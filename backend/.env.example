# Required for the server to boot at all (see server.js) — never falls back silently.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=mercado_harley
JWT_SECRET=change-this-to-a-long-random-value
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public backend URL — used to build the Mercado Pago webhook notification_url.
BACKEND_URL=http://localhost:3001
# Comma-separated list of extra allowed CORS origins, if you need more than FRONTEND_URL
# CORS_ORIGINS=https://sickgrip.com.br,https://www.sickgrip.com.br

# Melhor Envio
MELHOR_ENVIO_TOKEN=your_token_here
MELHOR_ENVIO_FROM_CEP=your_cep_here
MELHOR_ENVIO_SANDBOX=true

# Mercado Pago — note the code reads MP_ACCESS_TOKEN (not MERCADOPAGO_ACCESS_TOKEN).
MP_ACCESS_TOKEN=your_token_here
# Secret key from the Mercado Pago panel (Notificações Webhooks) — required to
# validate that incoming /api/webhooks/mercadopago requests really come from them.
MP_WEBHOOK_SECRET=your_webhook_secret_here
# Set to "true" to simulate payments locally without calling Mercado Pago at all.
MOCK_PAYMENTS=false

# Email Service (Resend) — note the code reads EMAIL_FROM (not RESEND_FROM_EMAIL).
RESEND_API_KEY=your_resend_key_here
EMAIL_FROM=onboarding@resend.dev

# Local image uploads (product/banner images are stored on disk, not Cloudinary —
# there is no Cloudinary integration in this codebase despite the package name).
# Both are optional; sane defaults are auto-detected if omitted.
# UPLOADS_DIR=/var/www/mercadoHarley/uploads
# UPLOADS_BASE_URL=https://sickgrip.com.br/uploads
