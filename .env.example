# ============================================================
# Frontend (Vite) — only VITE_* variables are ever exposed to the browser bundle.
# ============================================================
VITE_API_URL=http://localhost:3001
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercado_pago_public_key_here

# ============================================================
# Backend — copy these into backend/.env (they are NOT read from this file by
# the backend; see backend/.env.example for the canonical backend template).
# Kept here too since this is often the first file a new dev opens.
# ============================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=mercado_harley

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production-use-strong-password
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Server Configuration
PORT=3001
NODE_ENV=development
# For Hostinger: use your domain/IP
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
# Comma-separated list of extra allowed CORS origins, if you need more than FRONTEND_URL
# CORS_ORIGINS=https://sickgrip.com.br,https://www.sickgrip.com.br

# External APIs - Payments (code reads MP_ACCESS_TOKEN, not MERCADOPAGO_ACCESS_TOKEN)
MP_ACCESS_TOKEN=your_mercado_pago_token_here
# Secret key from the Mercado Pago panel (Notificações Webhooks) — required to
# validate that incoming /api/webhooks/mercadopago requests really come from them.
MP_WEBHOOK_SECRET=your_webhook_secret_here
MOCK_PAYMENTS=false

# External APIs - Shipping
MELHOR_ENVIO_TOKEN=your_melhor_envio_token_here
MELHOR_ENVIO_FROM_CEP=91030170
MELHOR_ENVIO_SANDBOX=false

# Email Service (code reads EMAIL_FROM, not RESEND_FROM_EMAIL)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@seudominio.com
